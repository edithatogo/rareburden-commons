{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden-commons.org/schemas/release-candidate-receipt.schema.json",
  "title": "Release candidate evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_kind", "candidate", "environment", "run", "review"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "receipt_kind": {"type": "string", "enum": ["usability", "reproduction", "clean_build"]},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "release_manifest_id", "artefact_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_manifest_id": {"type": "string", "minLength": 1},
        "artefact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "runtime", "isolation"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "isolation": {"type": "string", "enum": ["clean-clone", "disposable-environment"]}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["commands", "outcome", "discrepancies", "intervention"],
      "properties": {
        "commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "task_ids": {"type": "array", "items": {"type": "string"}},
        "outputs_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "outcome": {"type": "string", "enum": ["pass", "qualified", "fail"]},
        "discrepancies": {"type": "array", "items": {"type": "string"}},
        "intervention": {"type": "string", "enum": ["none", "documented"]}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["operator_role", "reviewer_role", "notes"],
      "properties": {
        "operator_role": {"type": "string", "enum": ["independent-user", "independent-operator"]},
        "reviewer_role": {"type": "string", "minLength": 1},
        "decision_expiry_utc": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
