{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/node-disclosure-policy.schema.json",
  "title": "Federated node disclosure policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "minimum_cell_count", "participant_fields", "export_mode"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "policy_id": {"type": "string", "minLength": 3},
    "minimum_cell_count": {"type": "integer", "minimum": 1},
    "participant_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "export_mode": {"enum": ["aggregate_only", "metadata_only"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
