{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/ontology-mapping.schema.json",
  "title": "Ontology mapping set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping_set_id",
    "title",
    "version",
    "source_system",
    "source_version",
    "target_system",
    "target_version",
    "mappings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "mapping_set_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "target_system": {
      "type": "string",
      "minLength": 1
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_code",
          "target_code",
          "relation",
          "confidence",
          "status",
          "rationale",
          "evidence_refs"
        ],
        "properties": {
          "source_code": {
            "type": "string",
            "minLength": 1
          },
          "target_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "relation": {
            "type": "string",
            "enum": [
              "exact",
              "narrower",
              "broader",
              "related",
              "unmapped"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "moderate",
              "low",
              "unclear"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "provisional",
              "rejected"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
