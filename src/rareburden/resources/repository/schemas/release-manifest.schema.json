{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/release-manifest.schema.json",
  "title": "RareBurden release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_manifest_id",
    "release_id",
    "software_version",
    "created_at",
    "release_kind",
    "data_classification",
    "repository",
    "materials",
    "artefacts",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "release_manifest_id": {
      "type": "string",
      "pattern": "^rel-[0-9a-f]{24}$"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "software_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_kind": {
      "type": "string",
      "enum": [
        "software",
        "data",
        "software_or_data",
        "synthetic_assurance",
        "documentation"
      ]
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "synthetic",
        "mixed_public_synthetic"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree_state",
        "tag"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_state": {
          "type": "string",
          "enum": [
            "clean",
            "dirty",
            "unavailable"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artefacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artefact_count",
        "artefact_bytes",
        "material_count"
      ],
      "properties": {
        "artefact_count": {
          "type": "integer",
          "minimum": 1
        },
        "artefact_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "material_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
