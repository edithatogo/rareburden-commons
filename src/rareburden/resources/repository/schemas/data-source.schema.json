{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.example/schemas/data-source.schema.json",
  "title": "RareBurden Commons data source catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_updated",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "name",
        "custodian",
        "domains",
        "access_class",
        "data_level",
        "geographic_scope",
        "primary_uses",
        "access_url",
        "access_route",
        "licence",
        "redistribution",
        "registration_required",
        "version_strategy",
        "limitations",
        "status",
        "last_verified"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "custodian": {
          "type": "string",
          "minLength": 2
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ontology",
              "coding",
              "epidemiology",
              "population",
              "mortality",
              "health_burden",
              "health_expenditure",
              "socioeconomic",
              "gene_disease",
              "variant",
              "phenotype",
              "genomics",
              "electronic_health_record",
              "registry",
              "data_discovery",
              "patient_reported",
              "economic_social"
            ]
          }
        },
        "access_class": {
          "type": "string",
          "enum": [
            "open_download_api",
            "public_web_registration",
            "controlled_research",
            "federated_partner",
            "new_collection"
          ]
        },
        "data_level": {
          "type": "string",
          "enum": [
            "metadata",
            "aggregate",
            "knowledge_base",
            "individual_level",
            "mixed"
          ]
        },
        "geographic_scope": {
          "type": "string",
          "minLength": 2
        },
        "primary_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "access_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "access_route": {
          "type": "string",
          "minLength": 8
        },
        "licence": {
          "type": "string",
          "minLength": 2
        },
        "redistribution": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "conditional",
            "unknown"
          ]
        },
        "registration_required": {
          "type": "boolean"
        },
        "version_strategy": {
          "type": "string",
          "minLength": 8
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "notes": {
          "type": "string"
        },
        "official_reference": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "approved",
            "blocked",
            "deprecated"
          ]
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "analytic_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "geographic_levels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "global",
              "regional",
              "national",
              "subnational_1",
              "subnational_2",
              "local",
              "cohort"
            ]
          }
        },
        "maximum_geographic_resolution": {
          "type": "string",
          "enum": [
            "global",
            "regional",
            "national",
            "subnational_1",
            "subnational_2",
            "local",
            "cohort"
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metadata_review": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "verified_at",
                "evidence"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "not_tested",
                    "preliminary",
                    "passed",
                    "failed",
                    "blocked"
                  ]
                },
                "verified_at": {
                  "type": "string",
                  "format": "date"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "access_test": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "verified_at",
                "evidence"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "not_tested",
                    "preliminary",
                    "passed",
                    "failed",
                    "blocked"
                  ]
                },
                "verified_at": {
                  "type": "string",
                  "format": "date"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "acquisition_test": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "verified_at",
                "evidence"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "not_tested",
                    "preliminary",
                    "passed",
                    "failed",
                    "blocked"
                  ]
                },
                "verified_at": {
                  "type": "string",
                  "format": "date"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "terms_review": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "verified_at",
                "evidence"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "not_tested",
                    "preliminary",
                    "passed",
                    "failed",
                    "blocked"
                  ]
                },
                "verified_at": {
                  "type": "string",
                  "format": "date"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
