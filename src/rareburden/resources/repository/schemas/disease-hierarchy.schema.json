{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/disease-hierarchy.schema.json",
  "title": "Burden-purpose disease hierarchy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hierarchy_id",
    "title",
    "version",
    "purpose",
    "entities",
    "aggregation_sets",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "hierarchy_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "preferred_label",
          "entity_type",
          "aggregation_role",
          "parents",
          "codes",
          "definition",
          "limitations"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "preferred_label": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "common_envelope",
              "rare_disease_group",
              "rare_disease",
              "residual_group"
            ]
          },
          "aggregation_role": {
            "type": "string",
            "enum": [
              "root",
              "intermediate",
              "leaf"
            ]
          },
          "parents": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "system",
                "code"
              ],
              "properties": {
                "system": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "aggregation_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregation_id",
          "parent_entity_id",
          "member_entity_ids",
          "strategy",
          "exhaustive",
          "rationale",
          "limitations"
        ],
        "properties": {
          "aggregation_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "parent_entity_id": {
            "type": "string",
            "minLength": 1
          },
          "member_entity_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "strategy": {
            "type": "string",
            "enum": [
              "mutually_exclusive_sum",
              "union_requires_overlap_adjustment",
              "contextual_do_not_sum"
            ]
          },
          "exhaustive": {
            "type": "boolean"
          },
          "unclassified_member_id": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
