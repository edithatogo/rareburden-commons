{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/assumption.schema.json",
  "title": "RareBurden analysis assumption",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assumption_id",
    "revision",
    "title",
    "rationale",
    "assumption_type",
    "analysis_ids",
    "status",
    "created_at",
    "owner_role",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "assumption_id": {
      "type": "string",
      "pattern": "^asm-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revision": {"type": "integer", "minimum": 1},
    "supersedes_assumption_id": {
      "type": "string",
      "pattern": "^asm-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {"type": "string", "minLength": 3},
    "rationale": {"type": "string", "minLength": 20},
    "assumption_type": {
      "enum": ["structural", "distributional", "transportability", "missingness", "operational"]
    },
    "analysis_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "parameter_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "status": {"enum": ["draft", "approved", "rejected", "superseded"]},
    "created_at": {"type": "string", "format": "date-time"},
    "owner_role": {"type": "string", "minLength": 3},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    }
  }
}
