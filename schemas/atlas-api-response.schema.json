{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden-commons.org/schemas/atlas-api-response.schema.json",
  "title": "Read-only atlas aggregate response",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_schema_version", "endpoint", "read_only", "release_id", "source_manifest_id", "package_fingerprint", "missingness_policy", "rows", "limitations"],
  "properties": {
    "api_schema_version": {"const": "0.1.0"},
    "endpoint": {"type": "string", "pattern": "^/"},
    "read_only": {"const": true},
    "release_id": {"type": "string", "minLength": 1},
    "source_manifest_id": {"type": "string", "minLength": 1},
    "package_fingerprint": {"type": "string", "pattern": "^atlas-[0-9a-f]+$"},
    "missingness_policy": {"const": "preserve_missing_not_zero"},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
