{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/acquisition-manifest.schema.json",
  "title": "Acquisition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acquisition_id",
    "source_id",
    "release_id",
    "method",
    "requested_url",
    "resolved_url",
    "retrieved_at",
    "pinning",
    "artifact",
    "response",
    "tool",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "acquisition_id": {
      "type": "string",
      "pattern": "^acq-[0-9a-f]{24}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "method": {
      "type": "string",
      "enum": [
        "manual_registration",
        "direct_download",
        "api_download"
      ]
    },
    "requested_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "resolved_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "pinning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_sha256",
        "status"
      ],
      "properties": {
        "expected_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "candidate_unpinned"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "etag",
        "last_modified"
      ],
      "properties": {
        "etag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_modified": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "git_commit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
