{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/parameter-ledger.schema.json",
  "title": "RareBurden parameter ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "title",
    "created_at",
    "parameters",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter_id",
          "parameter_revision",
          "label",
          "quantity_type",
          "measure",
          "metric",
          "unit",
          "distribution",
          "evidence_status",
          "uncertainty_status",
          "licence_state",
          "source_release_ids",
          "transformation_ids",
          "semantic_entity_ids",
          "population",
          "period",
          "limitations",
          "evidence_assessment_ids",
          "transportability_assessment_ids"
        ],
        "properties": {
          "parameter_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "parameter_revision": {
            "type": "integer",
            "minimum": 1
          },
          "supersedes_parameter_fingerprint": {
            "type": "string",
            "pattern": "^par-[0-9a-f]{24}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "quantity_type": {
            "type": "string",
            "enum": [
              "population",
              "fraction",
              "case_count",
              "rate",
              "cost",
              "health_loss",
              "other"
            ]
          },
          "measure": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "distribution": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "value"
                ],
                "properties": {
                  "type": {
                    "const": "fixed"
                  },
                  "value": {
                    "type": "number"
                  },
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "lower",
                  "upper"
                ],
                "properties": {
                  "type": {
                    "const": "uniform"
                  },
                  "lower": {
                    "type": "number"
                  },
                  "upper": {
                    "type": "number"
                  },
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "mean",
                  "standard_deviation"
                ],
                "properties": {
                  "type": {
                    "const": "normal"
                  },
                  "mean": {
                    "type": "number"
                  },
                  "standard_deviation": {
                    "type": "number"
                  },
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "mu",
                  "sigma"
                ],
                "properties": {
                  "type": {
                    "const": "lognormal"
                  },
                  "mu": {
                    "type": "number"
                  },
                  "sigma": {
                    "type": "number"
                  },
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "alpha",
                  "beta"
                ],
                "properties": {
                  "type": {
                    "const": "beta"
                  },
                  "alpha": {
                    "type": "number"
                  },
                  "beta": {
                    "type": "number"
                  },
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "observed",
              "transformed",
              "synthesised",
              "derived",
              "modelled",
              "transferred",
              "assumed"
            ]
          },
          "uncertainty_status": {
            "enum": ["quantified", "not_quantified", "not_applicable"]
          },
          "licence_state": {
            "enum": ["permitted", "restricted", "unknown", "not_applicable"]
          },
          "source_release_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "transformation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "semantic_entity_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "assumption_rationale": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "object",
            "additionalProperties": false,
            "required": ["population_id", "geography_id"],
            "properties": {
              "population_id": {"type": "string", "minLength": 1},
              "geography_id": {"type": "string", "minLength": 1},
              "sex": {"enum": ["all", "female", "male", "other", "unknown"]},
              "age_min": {"type": "integer", "minimum": 0},
              "age_max": {"type": ["integer", "null"], "minimum": 0}
            }
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "string", "format": "date"},
              "end": {"type": "string", "format": "date"}
            }
          },
          "disease_definition": {
            "type": "object"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          },
          "evidence_assessment_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^eqa-[0-9a-f]{24}$"
            }
          },
          "transportability_assessment_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^tra-[0-9a-f]{24}$"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
