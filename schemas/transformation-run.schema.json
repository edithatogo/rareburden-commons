{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/transformation-run.schema.json",
  "title": "RareBurden retrospective transformation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transformation_run_id",
    "activity_id",
    "title",
    "status",
    "prospective_plan",
    "execution",
    "inputs",
    "outputs",
    "parameters",
    "software",
    "environment",
    "agents",
    "limitations",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "transformation_run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{24}$"
    },
    "activity_id": {
      "type": "string",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "prospective_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "protocol",
        "protocol_version"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 3
        },
        "protocol": {
          "type": "string",
          "minLength": 3
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "registered_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "preregistration": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "ended_at"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "parameters": {
      "type": "object"
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "entry_point",
        "command",
        "git_commit",
        "git_tree_state"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_tree_state": {
          "enum": [
            "clean",
            "dirty",
            "unavailable"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "platform"
      ],
      "properties": {
        "python": {
          "type": "object",
          "required": [
            "implementation",
            "version"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "platform": {
          "type": "object",
          "required": [
            "system",
            "release",
            "machine"
          ],
          "properties": {
            "system": {
              "type": "string"
            },
            "release": {
              "type": "string"
            },
            "machine": {
              "type": "string"
            }
          }
        },
        "lockfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "container_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repository_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": true
    },
    "randomness": {
      "type": "object",
      "required": [
        "algorithm",
        "deterministic"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "algorithm_version": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "deterministic": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "orcid": {
            "type": "string",
            "format": "uri"
          },
          "ror": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "media_type",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 3
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "source_release_id": {
          "type": "string",
          "minLength": 1
        },
        "acquisition_manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "licence_state": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
