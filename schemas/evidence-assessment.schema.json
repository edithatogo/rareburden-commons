{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/evidence-assessment.schema.json",
  "title": "RareBurden evidence quality assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "subject",
    "assessed_at",
    "assessor",
    "framework_version",
    "domains",
    "overall_judgement",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "assessment_id": {"type": "string", "pattern": "^eqa-[0-9a-f]{24}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id"],
      "properties": {
        "subject_type": {
          "enum": ["source_release", "normalised_dataset", "parameter", "analysis", "release"]
        },
        "subject_id": {"type": "string", "minLength": 3}
      }
    },
    "assessed_at": {"type": "string", "format": "date-time"},
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "independence"],
      "properties": {
        "role": {"type": "string", "minLength": 3},
        "identifier": {"type": "string", "minLength": 3},
        "independence": {
          "enum": ["producer", "internal_independent", "external_independent", "community_reviewer"]
        }
      }
    },
    "framework_version": {"const": "RareBurden-EQA-1.0.0"},
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/domainAssessment"}
    },
    "overall_judgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale", "unresolved_questions"],
      "properties": {
        "decision": {
          "enum": ["direct_use", "use_with_adjustment", "sensitivity_only", "unsuitable", "unclear"]
        },
        "rationale": {"type": "string", "minLength": 20},
        "unresolved_questions": {
          "type": "array",
          "items": {"type": "string", "minLength": 3},
          "uniqueItems": true
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 3},
      "uniqueItems": true
    }
  },
  "$defs": {
    "domainAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "judgement", "rationale", "evidence_refs"],
      "properties": {
        "domain": {
          "enum": [
            "construct_validity",
            "case_definition",
            "ascertainment",
            "selection_bias",
            "measurement_error",
            "missingness",
            "precision",
            "representativeness",
            "temporal_relevance",
            "geographic_relevance",
            "diagnostic_validity",
            "linkage_quality",
            "outcome_completeness",
            "conflict_of_interest",
            "computational_reproducibility"
          ]
        },
        "judgement": {
          "enum": ["low_concern", "some_concern", "high_concern", "unclear", "not_applicable"]
        },
        "rationale": {"type": "string", "minLength": 15},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 3},
          "uniqueItems": true
        }
      }
    }
  }
}
