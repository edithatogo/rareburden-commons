{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/protocol-registration.schema.json",
  "title": "RareBurden protocol registration and amendment record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_registration_id", "protocol_id", "title", "version", "status", "created_at", "frozen_at", "registration", "protocol_snapshot", "research_questions", "estimands", "planned_analyses", "exclusions", "amendments", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_registration_id": {"type": "string", "pattern": "^protocol-[0-9a-f]{24}$"},
    "protocol_id": {"type": "string", "minLength": 3},
    "title": {"type": "string", "minLength": 8},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "internally_frozen", "externally_preregistered", "amended", "retired"]},
    "created_at": {"type": "string", "format": "date-time"},
    "frozen_at": {"type": ["string", "null"], "format": "date-time"},
    "registration": {
      "type": "object", "additionalProperties": false, "required": ["service", "url"],
      "properties": {
        "service": {"type": ["string", "null"], "minLength": 2},
        "url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "protocol_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"const": "text/markdown"}
      }
    },
    "research_questions": {"$ref": "#/$defs/nonemptyStrings"},
    "estimands": {"$ref": "#/$defs/nonemptyStrings"},
    "planned_analyses": {"$ref": "#/$defs/nonemptyStrings"},
    "exclusions": {"$ref": "#/$defs/strings"},
    "limitations": {"$ref": "#/$defs/strings"},
    "amendments": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["amendment_id", "recorded_at", "description", "rationale", "impact", "prospective"],
        "properties": {
          "amendment_id": {"type": "string", "minLength": 2},
          "recorded_at": {"type": "string", "format": "date-time"},
          "description": {"type": "string", "minLength": 3},
          "rationale": {"type": "string", "minLength": 3},
          "impact": {"type": "string", "minLength": 3},
          "prospective": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonemptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
