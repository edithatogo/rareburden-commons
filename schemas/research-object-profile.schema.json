{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/research-object-profile.schema.json",
  "title": "RareBurden structural profile for RO-Crate process-run metadata",
  "description": "A local structural guard; it does not replace validation against the normative RO-Crate and Process Run Crate specifications.",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "@graph"],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {"type": "string", "format": "uri"},
          {"type": "object"}
        ]
      }
    },
    "@graph": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["@id", "@type"],
        "properties": {
          "@id": {"type": "string", "minLength": 1},
          "@type": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            ]
          }
        },
        "additionalProperties": true
      }
    }
  }
}
