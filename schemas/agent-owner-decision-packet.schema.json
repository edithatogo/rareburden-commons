{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden-commons.org/schemas/agent-owner-decision-packet.schema.json",
  "title": "Prospective simulated-agent advice and owner decision packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "simulation_status", "track_id", "candidate", "panel", "evidence", "uncertainty", "dissent", "stop_triggers", "options", "recommendation", "owner_decision"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "simulation_status": {"const": "simulated_role_separated_advisory_panel"},
    "track_id": {"type": "string", "pattern": "^[0-9]{3}-[a-z0-9-]+$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "evidence_manifest_sha256"], "properties": {
      "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "evidence_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }},
    "panel": {"type": "object", "additionalProperties": false, "required": ["perspectives", "non_representation_statement"], "properties": {
      "perspectives": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}, "non_representation_statement": {"type": "string", "minLength": 20}
    }},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["references", "observed_facts", "simulated_assessments", "cannot_infer"], "properties": {
      "references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "observed_facts": {"type": "array", "items": {"type": "string", "minLength": 1}}, "simulated_assessments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "cannot_infer": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
    }},
    "uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dissent": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stop_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "options": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "disposition", "trade_offs", "contingencies", "rationale", "minimum_evidence"], "properties": {
      "id": {"type": "string", "pattern": "^[A-C]$"}, "title": {"type": "string", "minLength": 3}, "disposition": {"enum": ["accept", "narrow", "revise", "defer", "stop"]}, "trade_offs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "contingencies": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "rationale": {"type": "string", "minLength": 10}, "minimum_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }}},
    "recommendation": {"type": "object", "additionalProperties": false, "required": ["option_id", "rationale"], "properties": {"option_id": {"type": "string", "pattern": "^[A-C]$"}, "rationale": {"type": "string", "minLength": 10}}},
    "owner_decision": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "pending"}}},
      {"type": "object", "additionalProperties": false, "required": ["status", "selected_option_id", "decided_by", "decided_at_utc", "rationale"], "properties": {"status": {"const": "recorded"}, "selected_option_id": {"type": "string", "pattern": "^[A-C]$"}, "decided_by": {"const": "edithatogo"}, "decided_at_utc": {"type": "string", "format": "date-time"}, "rationale": {"type": "string", "minLength": 10}}}
    ]}
  }
}
