{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rareburden.org/schemas/initiative-landscape.schema.json",
  "title": "RareBurden initiative landscape",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_updated",
    "review_status",
    "scope",
    "initiatives",
    "decision",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "internal_review",
        "external_review",
        "complete"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 30
    },
    "initiatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "initiative_id",
          "name",
          "initiative_type",
          "status",
          "official_url",
          "data_access",
          "patient_level_data",
          "federated",
          "rareburden_relationship",
          "overlap_dimensions",
          "unique_contribution",
          "remaining_gap",
          "recommended_engagement",
          "evidence_references",
          "last_verified"
        ],
        "properties": {
          "initiative_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "initiative_type": {
            "type": "string",
            "enum": [
              "policy_mandate",
              "commission",
              "research_infrastructure",
              "data_platform",
              "ontology",
              "burden_programme",
              "registry_network",
              "standards_body",
              "advocacy_network",
              "funding_programme"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "developing",
              "completed",
              "planned",
              "unknown"
            ]
          },
          "official_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "data_access": {
            "type": "string",
            "enum": [
              "open",
              "registered",
              "controlled",
              "federated",
              "mixed",
              "not_applicable",
              "unknown"
            ]
          },
          "patient_level_data": {
            "type": "boolean"
          },
          "federated": {
            "type": "boolean"
          },
          "rareburden_relationship": {
            "type": "string",
            "enum": [
              "foundational_dependency",
              "candidate_partner",
              "adjacent_programme",
              "methodological_precedent",
              "policy_alignment",
              "potential_funder"
            ]
          },
          "overlap_dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "policy",
                "burden_estimation",
                "ontology",
                "data_discovery",
                "genomics",
                "registries",
                "federation",
                "patient_governance",
                "economic_burden",
                "standards",
                "funding"
              ]
            }
          },
          "unique_contribution": {
            "type": "string",
            "minLength": 20
          },
          "remaining_gap": {
            "type": "string",
            "minLength": 20
          },
          "recommended_engagement": {
            "type": "string",
            "minLength": 20
          },
          "evidence_references": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "last_verified": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "external_review_status",
        "decision_date",
        "rationale",
        "conditions"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "stop",
            "revise",
            "proceed_with_narrowed_scope",
            "proceed"
          ]
        },
        "external_review_status": {
          "type": "string",
          "enum": [
            "not_started",
            "planned",
            "in_progress",
            "complete"
          ]
        },
        "decision_date": {
          "type": "string",
          "format": "date"
        },
        "rationale": {
          "type": "string",
          "minLength": 30
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
